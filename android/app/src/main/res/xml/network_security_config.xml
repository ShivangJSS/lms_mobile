<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is off by default from Android 9 (API 28).

  IMPORTANT: Dart's HttpClient (Dio, Image.network) ignores this file, so the
  API and images work over plain http even for hosts not listed below. But
  NATIVE components — video_player/ExoPlayer, WebView — DO enforce it. That is
  why videos failed while everything else loaded: the LAN IP was not whitelisted
  and ExoPlayer blocked the request before it left the phone.

  For LAN development the API is served over plain http on an IP that changes
  often, so cleartext is permitted globally here via base-config. That keeps
  video working whatever the laptop's current IP is, without editing this file
  every time.

  PRODUCTION: remove the base-config below (or set cleartextTrafficPermitted
  to "false") and serve the API over https before shipping.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
