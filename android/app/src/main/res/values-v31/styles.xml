<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and up draw their own splash screen on top of the window
         background, with the launcher icon in the middle of it. That read as a
         second splash: the Azad mark on white, then the plain launch window,
         then the app. The icon carries the Azad mark on the artwork.s own paper tone, so this
         frame reads as the start of the splash rather than a blank screen.

         The system splash cannot be switched off outright, only styled. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
